NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
CORS_ORIGINS=https://admin.example.com,https://app.example.com
GOOGLE_DRIVE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_DRIVE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_DRIVE_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob
FCM_PROJECT_ID=replace_with_firebase_project_id
FCM_CLIENT_EMAIL=replace_with_firebase_client_email
FCM_PRIVATE_KEY=replace_with_firebase_private_key
