generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         String              @id @default(uuid())
  email                      String              @unique
  password                   String
  fullName                   String
  phoneNumber                String              @unique
  securityPin                String?
  avatarUrl                  String?
  userType                   String              @default("individual")
  role                       UserRole            @default(USER)
  pushToken                  String?
  isEmailVerified            Boolean             @default(false)
  isActive                   Boolean             @default(true)
  lastLoginAt                DateTime?
  referredByAgentId          String?
  referredAt                 DateTime?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt
  createdAdjustmentRequests  AdjustmentRequest[] @relation("AdjustmentCreatedBy")
  reviewedAdjustmentRequests AdjustmentRequest[] @relation("AdjustmentReviewedBy")
  adminActions               AdminAction[]
  agentProfile               Agent?              @relation("UserToAgent")
  auditLogs                  AuditLog[]
  business                   Business?
  commissions                Commission[]        @relation("CustomerCommissions")
  expenses                   Expense[]
  notifications              Notification[]
  approvedPayments           PaymentRequest[]    @relation("ApprovedPayments")
  paymentRequests            PaymentRequest[]
  refreshTokens              RefreshToken[]
  suggestions                Suggestion[]
  subscriptions              UserSubscription[]
  referredByAgent            Agent?              @relation("ReferredUsers", fields: [referredByAgentId], references: [id])

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "refresh_tokens_user_idx")
  @@index([expiresAt], map: "refresh_tokens_expires_idx")
  @@map("refresh_tokens")
}

model Business {
  id                    String                 @id @default(uuid())
  name                  String
  businessType          String?
  phoneNumber           String?
  email                 String?
  address               String?
  logoUrl               String?
  userId                String                 @unique
  subscriptionStatus    String                 @default("FREE")
  subscriptionExpiry    DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  receivedAdjustments   AdjustmentRequest[]    @relation("AdjustmentReceiver")
  requestedAdjustments  AdjustmentRequest[]    @relation("AdjustmentRequester")
  user                  User                   @relation(fields: [userId], references: [id])
  cloudBackupCredential CloudBackupCredential?
  cloudBackupRecords    CloudBackupRecord[]
  receivedConnections   Connection[]           @relation("Receiver")
  sentConnections       Connection[]           @relation("Requester")
  dueReminderLogs       DueReminderLog[]
  expenses              Expense[]
  receivedOrders        Order[]                @relation("OrderReceiver")
  sentOrders            Order[]                @relation("OrderSender")
  paymentRequests       PaymentRequest[]
  receivedTransactions  Transaction[]          @relation("TransactionReceiver")
  sentTransactions      Transaction[]          @relation("TransactionSender")
  subscriptions         UserSubscription[]

  @@map("businesses")
}

model Connection {
  id              String    @id @default(uuid())
  requesterId     String
  receiverId      String
  status          String    @default("PENDING")
  connectionType  String    @default("CUSTOMER")
  showPrices      Boolean   @default(false)
  blockedById     String?
  lastRequestedAt DateTime? @default(now())
  retryCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  account         Account?
  receiver        Business  @relation("Receiver", fields: [receiverId], references: [id])
  requester       Business  @relation("Requester", fields: [requesterId], references: [id])

  @@unique([requesterId, receiverId])
  @@map("connections")
}

model Account {
  id           String     @id @default(uuid())
  connectionId String     @unique
  balance      Decimal    @default(0.00) @db.Decimal(15, 2)
  totalCredit  Decimal    @default(0.00) @db.Decimal(15, 2)
  totalDebit   Decimal    @default(0.00) @db.Decimal(15, 2)
  creditLimit  Decimal    @default(100000) @db.Decimal(15, 2)
  billingCycle String?
  currency     String     @default("YER")
  dueDate      DateTime?
  updatedAt    DateTime   @updatedAt
  connection   Connection @relation(fields: [connectionId], references: [id])

  @@map("accounts")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique
  senderId        String
  receiverId      String
  status          String        @default("PENDING")
  isCash          Boolean       @default(false)
  currency        String        @default("YER")
  dueDate         DateTime?
  pricesVisible   Boolean       @default(true)
  priceAcceptedAt DateTime?
  subtotal        Decimal       @default(0.00) @db.Decimal(15, 2)
  tax             Decimal       @default(0.00) @db.Decimal(15, 2)
  discount        Decimal       @default(0.00) @db.Decimal(15, 2)
  paidAmount      Decimal       @default(0.00) @db.Decimal(15, 2)
  total           Decimal       @default(0.00) @db.Decimal(15, 2)
  notes           String?
  rejectionReason String?
  rejectedById    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  receiver        Business      @relation("OrderReceiver", fields: [receiverId], references: [id])
  sender          Business      @relation("OrderSender", fields: [senderId], references: [id])
  transactions    Transaction[]

  @@index([status])
  @@index([createdAt], map: "orders_created_at_idx")
  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  itemName    String
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(15, 2)
  total       Decimal @db.Decimal(15, 2)
  unit        String?
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Transaction {
  id              String    @id @default(uuid())
  transactionType String
  voucherNumber   String?
  amount          Decimal   @db.Decimal(15, 2)
  currency        String    @default("YER")
  dueDate         DateTime?
  attachmentUrl   String?
  balanceAfter    Decimal?  @db.Decimal(15, 2)
  senderId        String
  receiverId      String
  orderId         String?
  note            String?
  paymentMethod   String?
  transferNumber  String?
  createdAt       DateTime  @default(now())
  order           Order?    @relation(fields: [orderId], references: [id])
  receiver        Business  @relation("TransactionReceiver", fields: [receiverId], references: [id])
  sender          Business  @relation("TransactionSender", fields: [senderId], references: [id])

  @@index([createdAt], map: "transactions_created_at_idx")
  @@map("transactions")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  method     String?
  path       String?
  statusCode Int?
  businessId String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([businessId], map: "audit_logs_business_idx")
  @@index([createdAt], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}

model CloudBackupCredential {
  id           String    @id @default(uuid())
  businessId   String    @unique
  provider     String    @default("GOOGLE_DRIVE")
  refreshToken String
  email        String?
  scope        String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  business     Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("cloud_backup_credentials")
}

model CloudBackupRecord {
  id         String   @id @default(uuid())
  businessId String
  provider   String   @default("GOOGLE_DRIVE")
  fileId     String
  fileName   String
  fileSize   Int?
  checksum   String?
  status     String   @default("UPLOADED")
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId], map: "cloud_backup_records_business_idx")
  @@map("cloud_backup_records")
}

model Expense {
  id          String    @id @default(uuid())
  amount      Decimal   @db.Decimal(15, 2)
  description String
  date        DateTime  @default(now())
  userId      String
  businessId  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  business    Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model AdminAction {
  id         String   @id @default(uuid())
  adminId    String
  action     String
  targetType String
  targetId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  admin      User     @relation(fields: [adminId], references: [id])

  @@index([adminId], map: "admin_actions_admin_idx")
  @@index([createdAt], map: "admin_actions_created_at_idx")
  @@map("admin_actions")
}

model SystemSettings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

model Suggestion {
  id        String   @id @default(uuid())
  userId    String
  content   String
  whatsapp  String?
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@map("suggestions")
}

model AdjustmentRequest {
  id                  String    @id @default(uuid())
  requesterBusinessId String
  receiverBusinessId  String
  targetType          String
  targetId            String
  requestedAmount     Decimal?  @db.Decimal(15, 2)
  requestedDueDate    DateTime?
  requestedNote       String?
  reason              String
  status              String    @default("PENDING")
  rejectionReason     String?
  createdById         String
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           User      @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  receiverBusiness    Business  @relation("AdjustmentReceiver", fields: [receiverBusinessId], references: [id])
  requesterBusiness   Business  @relation("AdjustmentRequester", fields: [requesterBusinessId], references: [id])
  reviewedBy          User?     @relation("AdjustmentReviewedBy", fields: [reviewedById], references: [id])

  @@index([requesterBusinessId], map: "adjustment_requests_requester_idx")
  @@index([receiverBusinessId], map: "adjustment_requests_receiver_idx")
  @@index([targetType, targetId], map: "adjustment_requests_target_idx")
  @@map("adjustment_requests")
}

model DueReminderLog {
  id                  String   @id @default(uuid())
  connectionId        String
  accountId           String
  recipientBusinessId String
  reminderDate        DateTime
  dueDate             DateTime
  amount              Decimal  @db.Decimal(15, 2)
  direction           String
  createdAt           DateTime @default(now())
  recipientBusiness   Business @relation(fields: [recipientBusinessId], references: [id])

  @@unique([connectionId, recipientBusinessId, reminderDate], name: "due_reminder_once_per_day")
  @@index([recipientBusinessId], map: "due_reminder_logs_recipient_idx")
  @@index([dueDate], map: "due_reminder_logs_due_date_idx")
  @@map("due_reminder_logs")
}

model PaymentRequest {
  id           String               @id @default(uuid())
  userId       String
  businessId   String?
  amount       Decimal              @db.Decimal(15, 2)
  wallet       String
  status       PaymentRequestStatus @default(PENDING)
  notes        String?
  receiptUrl   String?
  approvedById String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  commissions  Commission[]
  approvedBy   User?                @relation("ApprovedPayments", fields: [approvedById], references: [id])
  business     Business?            @relation(fields: [businessId], references: [id])
  user         User                 @relation(fields: [userId], references: [id])

  @@map("payment_requests")
}

model SubscriptionPlan {
  id            String             @id @default(uuid())
  name          String
  description   String?
  price         Decimal            @db.Decimal(15, 2)
  durationDays  Int                @default(365)
  features      Json?
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id          String             @id @default(uuid())
  userId      String
  businessId  String?
  planId      String
  status      SubscriptionStatus @default(FREE)
  expiryDate  DateTime?
  autoRenew   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  commissions Commission[]
  business    Business?          @relation(fields: [businessId], references: [id])
  plan        SubscriptionPlan   @relation(fields: [planId], references: [id])
  user        User               @relation(fields: [userId], references: [id])

  @@map("user_subscriptions")
}

model Region {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agents    Agent[]

  @@map("regions")
}

model Agent {
  id              String             @id @default(uuid())
  userId          String             @unique
  referralCode    String             @unique
  regionId        String?
  commissionType  CommissionType     @default(PERCENTAGE)
  commissionValue Decimal            @default(10.00) @db.Decimal(15, 2)
  status          AgentStatus        @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  region          Region?            @relation(fields: [regionId], references: [id])
  user            User               @relation("UserToAgent", fields: [userId], references: [id], onDelete: Cascade)
  payouts         CommissionPayout[]
  commissions     Commission[]
  referredUsers   User[]             @relation("ReferredUsers")

  @@map("agents")
}

model Commission {
  id               String            @id @default(uuid())
  agentId          String
  customerId       String
  subscriptionId   String?
  paymentRequestId String?
  amount           Decimal           @db.Decimal(15, 2)
  status           CommissionStatus  @default(PENDING)
  notes            String?
  payoutId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  agent            Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  customer         User              @relation("CustomerCommissions", fields: [customerId], references: [id])
  paymentRequest   PaymentRequest?   @relation(fields: [paymentRequestId], references: [id])
  payout           CommissionPayout? @relation(fields: [payoutId], references: [id])
  subscription     UserSubscription? @relation(fields: [subscriptionId], references: [id])

  @@index([agentId], map: "commission_agent_idx")
  @@index([status], map: "commission_status_idx")
  @@map("commissions")
}

model CommissionPayout {
  id          String       @id @default(uuid())
  agentId     String
  totalAmount Decimal      @db.Decimal(15, 2)
  status      PayoutStatus @default(PENDING)
  paidAt      DateTime?
  receiptUrl  String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agent       Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([agentId], map: "payout_agent_idx")
  @@map("commission_payouts")
}

model ActivationCode {
  id           String    @id @default(uuid())
  code         String    @unique
  durationDays Int       @default(365)
  isUsed       Boolean   @default(false)
  usedByUserId String?
  usedAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("activation_codes")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SUPPORT
  USER
}

enum SubscriptionStatus {
  FREE
  GOLD
  EXPIRED
}

enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionType {
  PERCENTAGE
  FIXED
}

enum AgentStatus {
  PENDING
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PayoutStatus {
  PENDING
  PAID
}
